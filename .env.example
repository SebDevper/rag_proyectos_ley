# Copiar a .env y ajustar. Las variables definidas en el entorno tienen prioridad sobre este archivo.

# Almacenamiento local (en Cloudflare: R2 y D1)
DIR_CRUDO=data/raw
RUTA_DB=data/proyectos.sqlite

# Servicios web oficiales (ver docs/fuente-de-datos.md)
CAMARA_WS_URL=https://opendata.camara.cl/camaradiputados/WServices/WSLegislativo.asmx
SENADO_WS_URL=https://tramitacion.senado.cl/wspublico/tramitacion.php

# Descarga responsable: una solicitud a la vez, con pausas aleatorias entre estos valores
USER_AGENT=rag-proyectos-ley (proyecto de portafolio)
PAUSA_MIN_SEGUNDOS=1
PAUSA_MAX_SEGUNDOS=2

# Ventana del corpus: proyectos ingresados desde esta fecha (AAAA-MM-DD)
FECHA_DESDE=2026-10-16
